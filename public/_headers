# Cloudflare Pages reads this file (Vite copies public/ into dist/ as is).

# Built files have a content hash in their names, so they never change:
# browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is checked on every visit, so people always get the
# newest build.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# Each language's page (src/site/pages.ts).
/javascript
  Cache-Control: no-cache
/python
  Cache-Control: no-cache
/typescript
  Cache-Control: no-cache
/sql
  Cache-Control: no-cache

# Safe defaults for every response.
#
# The Content-Security-Policy: the page may only run its own scripts (no
# inline ones, no eval), load styles and fonts from itself and Google Fonts,
# connect only to itself, and embed only the code runner. Programs don't run
# here (they run on the runner's site, pr0l1ne-run.pages.dev, with its own
# strict policy: see src/sandbox/origins.ts), so this page needs no eval of
# its own; frame-src lets it embed the runner (and a branch's preview of
# it). The docs (VitePress, at /docs) have a few small inline scripts: the
# build adds each one's hash to script-src (scripts/docs-headers.mjs), which
# lets exactly those scripts run and nothing else. `npm run preview` sends
# the built headers (vite.shared.ts), and e2e/csp.e2e.ts checks the app runs
# under them.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-src https://pr0l1ne-run.pages.dev https://*.pr0l1ne-run.pages.dev; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
