# Cloudflare Pages reads this file (Vite copies public/ into dist/ as is).

# Built files have a content hash in their names, so they never change:
# browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is checked on every visit, so people always get the
# newest build.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Safe defaults for every response. A Content-Security-Policy comes later
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
