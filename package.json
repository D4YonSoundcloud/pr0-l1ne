{
  "name": "pr0l1ne",
  "private": true,
  "version": "0.1.0",
  "description": "See your code run: step through Python, JavaScript and TypeScript programs and watch memory, loops and complexity change.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build",
    "build:runner": "vite build -c vite.runner.config.ts",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "schema": "tsx scripts/schema.mjs",
    "trace": "python3 src/worker/tracer.py",
    "test:tracer": "python3 -m unittest discover -s src/worker -p 'test_*.py' -v",
    "test:js": "vitest run",
    "test": "vitest run && npm run test:tracer && npm run test:pyodide",
    "test:golden": "vitest run src/examples/golden.test.ts",
    "test:coverage": "vitest run --coverage && npm run test:coverage:py",
    "test:coverage:py": "python3 -m coverage run -m unittest discover -s src/worker -p 'test_*.py' && python3 -m coverage report && python3 -m coverage html",
    "instrument": "tsx src/js/cli.ts",
    "trace:js": "tsx src/js/cli.ts --trace",
    "test:pyodide": "node scripts/test-pyodide.mjs",
    "lint": "biome check . && npm run lint:py",
    "lint:py": "ruff check && ruff format --check && pyright",
    "format": "biome check --write . && ruff check --fix && ruff format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "jsdom": "^30.1.2",
    "lefthook": "2.2.2",
    "pyright": "1.1.414",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "monaco-editor": "^0.57.0",
    "path-browserify": "^1.0.1",
    "pixi.js": "^8.22.0",
    "pyodide": "0.27.8"
  }
}
