{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "monaco-esm/*": ["./node_modules/monaco-editor/esm/vs/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": [
    "src/js/cli.ts",
    "src/render/layout.test.ts",
    "src/trace/hints.test.ts",
    "src/trace/graph.test.ts",
    "src/trace/memory.test.ts",
    "src/trace/complexity.test.ts",
    "src/trace/bigO.test.ts",
    "src/trace/gridFocus.test.ts",
    "src/examples/golden.test.ts",
    "src/trace/schema.test.ts",
    "src/testing/**/*.ts",
    "src/trace/conformance.test.ts"
  ]
}
