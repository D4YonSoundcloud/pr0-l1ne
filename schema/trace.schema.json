          "items": {
            "type": "string"
          }
        },
        "line": {
          "type": "number"
        }
      },
      "required": [
        "shape",
        "typeName",
        "links",
        "line"
      ],
      "additionalProperties": false,
      "description": "`viz: tree Node(left, right)` or `viz: list Node(next)`."
    },
    "GraphHint": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "A variable (`adj`, `self.adj`) or, with `fields`, a class."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a class: the fields that hold its neighbors."
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphOption"
          }
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line": {
          "type": "number"
        }
      },
      "required": [
        "target",
        "options",
        "names",
        "line"
      ],
      "additionalProperties": false,
      "description": "`viz: graph adj`, `viz: graph Node(neighbors)`, with options and the names of variables to draw on it: `viz: graph adj directed: seen, queue`."
