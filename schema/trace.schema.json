                "type": "string"
              }
            },
            "required": [
              "line",
              "message"
            ],
            "additionalProperties": false
          },
          "description": "Hints that couldn't be understood, to show to the person."
        }
      },
      "required": [
        "hide",
        "show",
        "pointers",
        "linked",
        "graphs",
        "plain",
        "sizes",
        "warnings"
