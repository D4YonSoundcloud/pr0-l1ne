            "kind",
            "sizes",
            "why"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "log"
            },
            "size": {
              "$ref": "#/definitions/SizeRef"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "size",
            "why"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "const"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "why"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "why"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How many times a loop runs, each time it's reached."
    },
    "SizeRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "len": {
          "type": "boolean"
        },
        "inner": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Something the running time can depend on, named as the program names it. `{ name: \"nums\", len: true }` is len(nums) / nums.length; `{ name: \"n\" }` is the value of n; `inner` is the length of one of its items (a row of a grid, a node's neighbor list). For an object, `len` is the number of objects of its kind reachable from it (a linked list's nodes). `name` can be dotted: \"self.items\"."
    },
    "Shrink": {
      "type": "string",
      "enum": [
        "minus",
        "half",
        "child",
        "same",
        "unknown"
      ],
      "description": "How a recursive call's arguments compare with the parameters: `minus` (n - 1, i + 1, items[1:]), `half` (n // 2, items[:mid]), `child` (node.left: one step down a structure), `same`, or `unknown` (anything else, like a neighbor in a search)."
    },
    "VizHints": {
      "type": "object",
      "properties": {
        "hide": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pointers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Extra index names, keyed like Trace.indexNames (\"nums\", \"grid[]\")."
        },
        "linked": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LinkedHint"
          }
        },
        "graphs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphHint"
          }
        },
        "plain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables or classes never to draw as a graph."
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "line": {
                "type": "number"
              }
            },
            "required": [
